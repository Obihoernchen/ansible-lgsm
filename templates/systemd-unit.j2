[Unit]
Description = {{ lgsm_server }}
After = network-online.target
Wants = network-online.target
# Restart = always would otherwise retry a broken server forever
StartLimitIntervalSec = 300
StartLimitBurst = 5

[Service]
Type = forking
WorkingDirectory = {{ lgsm_installdir }}
ExecStart = {{ lgsm_installdir }}/{{ lgsm_server }} start
ExecStop = {{ lgsm_installdir }}/{{ lgsm_server }} stop
User = {{ lgsm_user }}
# The main process is tmux, which exits cleanly when the gameserver crashes
Restart = always
RestartSec = 10s
TimeoutStopSec = 120

{% include 'systemd-hardening.j2' %}

[Install]
WantedBy = multi-user.target
